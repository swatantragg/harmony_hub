# ─────────────────────────────────────────────────────────────────────────────
#  GCloud — environment
#
#  Copy to .env and fill in. .env is gitignored and must never be committed.
#      cp .env.example .env
#
#  Every value here is validated by a Zod schema at boot (server/src/config.js).
#  A missing or malformed setting stops the process with a readable message rather
#  than failing later inside a request.
#
#  Shortest path to a working install:
#      npm run drive:auth        walks you through Google, prints the four GOOGLE_* lines
#      npm run bootstrap:drive   creates the folder tree, prints DRIVE_ROOT_FOLDER_ID
#      npm run drive:check       proves upload, download, rename, move and delete work
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
APP_ENV=dev
PORT=8100

# PUBLIC_ORIGIN — where the API answers. Signed file links are built from it, so it has
# to be an address the browser can actually reach.
PUBLIC_ORIGIN=http://localhost:8100

# APP_ORIGIN — where a person opens the app, and therefore what every **share link** is
# built from. Leave it BLANK: the API serves the built client itself, so it falls back to
# PUBLIC_ORIGIN, which is correct.
#
# Set it to http://localhost:8101 only while `npm run dev:web` is running — and change it
# back, because a share link created while it says 8101 points at a port that is dead the
# moment you stop the dev server.
APP_ORIGIN=

# Every browser origin allowed to call the API. 8101 is listed so the Vite dev server
# works when started, without needing an edit here.
CORS_ORIGINS=http://localhost:8100,http://localhost:8101

# ── Secrets ──────────────────────────────────────────────────────────────────
# Generate your own:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Generate: openssl rand -base64 48
# The process REFUSES TO START on a placeholder value, and in production on anything
# shorter than 32 characters. A guessable signing key means anybody can mint themselves
# an administrator session.
JWT_SECRET=CHANGE_ME_generate_a_long_random_string

# Access tokens are short-lived and held in memory in the browser; what keeps somebody
# signed in is the refresh cookie below. Do not raise ACCESS_TTL_SEC to avoid signing in
# — that is what the refresh token is for, and a long access token cannot be revoked.
ACCESS_TTL_SEC=900
REFRESH_TTL_SEC=1209600
# Absolute ceiling on a session however often it is refreshed, and the idle cut-off.
SESSION_MAX_SEC=2592000
SESSION_IDLE_SEC=43200
BCRYPT_ROUNDS=12

# Signs the short-lived tokens that authorise a single file download or preview. Leave
# blank to reuse JWT_SECRET. Rotating it invalidates every outstanding file link
# immediately, which is the fastest way to cut off access after a leak.
FILE_TOKEN_SECRET=

# ── MongoDB ──────────────────────────────────────────────────────────────────
# docker compose --profile local up -d mongo   gives you this URI locally.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=gcloud

# Only for the OPTIONAL local MongoDB container (docker compose --profile local). It runs
# with --auth and binds to loopback. Left blank, it creates no user and admits nobody —
# which is the safe failure, not an open database.
MONGO_ROOT_USER=gcloud
MONGO_ROOT_PASSWORD=

# ── Google Drive ─────────────────────────────────────────────────────────────
#
# Two ways in, and they are genuinely different accounts. Pick one.
#
#   oauth            Your own Google account. Files land in your Drive, against your
#                    15 GB. One consent flow, then it just works. USE THIS TO TEST.
#
#   service_account  A robot account with a key file. It has no Drive storage of its
#                    own, so it can only write into a Shared Drive (set DRIVE_ID) whose
#                    quota belongs to a Google Workspace, or impersonate a real Workspace
#                    user via domain-wide delegation. Right for a team, wrong for a trial.
#
GOOGLE_AUTH_MODE=oauth

# ── oauth mode ───────────────────────────────────────────────────────────────
# `npm run drive:auth` prints all three. It opens the consent screen, catches the
# redirect and does the code exchange for you — nothing has to be pasted into a form.
#
# Redirect URI to register on the OAuth client: http://localhost:8107/oauth2callback
#
# Note: while the OAuth consent screen sits in "Testing", Google expires refresh tokens
# after 7 days. Click "Publish app" before anyone depends on this.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ── service_account mode ─────────────────────────────────────────────────────
# Either paste the two fields out of the downloaded JSON key, or point at the file.
# GOOGLE_PRIVATE_KEY must keep its literal \n escapes and be wrapped in double quotes.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./secrets/gcloud-drive.json

# Domain-wide delegation only: the Workspace user the robot acts as. Leave blank unless
# a Workspace admin has authorised the client id for the Drive scope.
GOOGLE_IMPERSONATE_SUBJECT=

# ── Where the library lives ──────────────────────────────────────────────────
# Shared Drive id — the string after /drive/folders/ when you open a Shared Drive.
# Leave blank for My Drive, which is what oauth mode normally wants.
DRIVE_ID=

# The folder everything lives under. Leave blank and GCloud finds or creates
# DRIVE_ROOT_FOLDER_NAME at the top of the Drive; `npm run bootstrap:drive` prints the id
# it settled on, and pinning it here saves a lookup on every boot.
DRIVE_ROOT_FOLDER_ID=
DRIVE_ROOT_FOLDER_NAME=GCloud

# ── Docker ───────────────────────────────────────────────────────────────────
# Read only by docker-compose, and only by the container. Inside a container 127.0.0.1 is
# the container itself, so anything running on your machine needs a different name: a
# compose service (`mongo`) or `host.docker.internal`.
#   local Mongo   → DOCKER_MONGODB_URI=mongodb://mongo:27017
#   Atlas         → leave blank, the Atlas URI already resolves from anywhere
#
# Google Drive needs nothing here: it is the same public API from inside a container as
# from outside, so there is nothing to emulate and nothing to address differently.
DOCKER_MONGODB_URI=

# ── Signed link lifetimes, seconds ───────────────────────────────────────────
# Downloads and previews are streamed through /api/files against a short-lived signed
# ticket. These are those lifetimes.
TTL_DOWNLOAD=300
TTL_PREVIEW=3600
TTL_UPLOAD_PART=3600
TTL_SHARE=3600

# ── Transfer tuning ──────────────────────────────────────────────────────────
# Resumable upload chunk size. Google requires a multiple of 256 KiB and the value is
# rounded down to one. Larger is faster on a good connection and costs more to retry.
DRIVE_CHUNK_MB=8

# files.get fan-out ceiling. Deliberately conservative: Drive allows roughly 1,000
# requests per 100 seconds per user, and reconciliation is the thing that would hit it.
HEAD_CONCURRENCY=12
VERIFY_BATCH_MAX=500
DRIVE_LIST_PAGE_SIZE=1000

# How long Google keeps a trashed file before deleting it for good. Google's own value is
# 30 days; this is what the UI quotes, so change it only if Google does.
DRIVE_TRASH_DAYS=30

# ── De-duplication ───────────────────────────────────────────────────────────
# The exact tier needs none of these — it compares the sha256 Google computes on every
# upload, so it is free and cannot be wrong. These only tune the "probably the same
# thing" tiers, which always ask a human before anything happens.
#
# How close two file sizes must be to be considered the same media (0.02 = 2%).
DEDUPE_SIZE_TOLERANCE=0.02
# How close two running times must be, in seconds.
DEDUPE_DURATION_TOLERANCE_SEC=2
# How similar two names must be once copy suffixes and version tags are stripped (0-1).
DEDUPE_NAME_SIMILARITY=0.7

# Perceptual matching finds the same footage at different resolutions and bitrates, which
# no checksum can. It needs ffmpeg on PATH and reads every file back out of Drive, so it
# is opt-in and runs as a background job from the De-duplication screen.
DEDUPE_PERCEPTUAL=false
DEDUPE_PERCEPTUAL_FRAMES=8
# Hamming distance, out of 64 bits. Lower is stricter. 10 is a good starting point.
DEDUPE_PERCEPTUAL_MAX_DISTANCE=10

# ── Reconciliation ───────────────────────────────────────────────────────────
# Compares the catalogue against the Drive nightly. A Drive is a place people can open and
# rearrange by hand, so files get renamed, moved and binned without the app ever hearing
# about it — this is what notices.
RECONCILE_ENABLED=true
RECONCILE_CRON=0 2 * * *

# ── Seeding ──────────────────────────────────────────────────────────────────
# Fills an empty library on first boot with ~120 real files (a few MB in total), including
# deliberate drift and deliberate duplicates so Storage health and De-duplication both
# have something true to show. It never overwrites a library that has data;
# `npm run reseed` is the destructive path.
SEED_ON_BOOT=true
# The password the seeded colleague accounts are created with. It is a handover value, not
# a credential: every account holding it is required to replace it at first sign-in, and
# the boot banner names any that still do.
# Generate one: openssl rand -base64 12   (production refuses well-known defaults)
SEED_PASSWORD=changeme123

# ── Accounts ─────────────────────────────────────────────────────────────────
# The founding administrator, created on an empty database and repaired on every boot if
# it is missing, suspended or no longer an Admin. This is the only account born with a
# password of its own and no forced change — so change it here before a real deployment,
# or sign in once and set a new one from the app.
#
# There are two roles. An Admin can add people; a User can do everything else the product
# offers. Nothing else distinguishes them.
ADMIN_EMAIL=swatantra.goongoonalo@gmail.com
ADMIN_NAME=Swatantra Goongoonalo
# Generate one: openssl rand -base64 12
# An administrator account already holding a well-known default is forced to replace it
# at the next sign-in, whatever this says.
ADMIN_PASSWORD=CHANGE_ME_before_first_boot

# Minimum length for any password the application accepts. Length is the only rule —
# character-class requirements push people towards predictable patterns.
MIN_PASSWORD_LENGTH=12
PASSWORD_BREACH_CHECK=false

# ── Limits and logging ───────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_MAX=600
RATE_LIMIT_HEAVY_MAX=60
# The byte path is unauthenticated by design (the ticket is the authorisation), so it
# gets a budget of its own rather than none.
RATE_LIMIT_FILES_MAX=600

# ── The credential surface ───────────────────────────────────────────────────
# Sign-in, password change and re-authentication. Counted per address AND per account,
# then an account-level lockout, because an address is trivially rotated and the account
# is the thing being attacked.
RATE_LIMIT_AUTH_WINDOW_SEC=900
RATE_LIMIT_AUTH_MAX=10
LOGIN_MAX_FAILURES=8
LOGIN_LOCKOUT_SEC=900

# ── How far to trust X-Forwarded-For ─────────────────────────────────────────
# req.ip is what the rate limiter counts and what the audit trail records. `true` means
# "believe any client's header", which hands both to the caller. NEVER use it in public.
#   loopback  nothing in front (default)
#   1         behind exactly one reverse proxy
#   <cidr>    behind a known load balancer
TRUST_PROXY=loopback

# ── Content policy ───────────────────────────────────────────────────────────
# Per file, and per account per rolling 24 hours. Executable and web-page types are
# refused outright at upload and re-checked against the real bytes afterwards.
UPLOAD_MAX_BYTES=26843545600
UPLOAD_DAILY_BYTES=53687091200
# ── Malware scanning (ClamAV) ────────────────────────────────────────────────
# Off unless a daemon is running:  docker compose --profile av up -d clamav
# Then set CLAMAV_ENABLED=true and CLAMAV_HOST=clamav (the compose service name).
# Every completed upload is read back out of Drive and streamed past the scanner
# before it is catalogued; anything it identifies goes to Quarantine, not the library.
CLAMAV_ENABLED=false
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=120000
# clamd's own StreamMaxLength is 25 MB by default — raise both together or larger
# files are skipped rather than failed.
CLAMAV_MAX_BYTES=209715200
# What an unreachable scanner means. true refuses the upload; false accepts it with a
# warning in the audit trail. true by default: scanning that silently stops working is
# the failure worth designing against.
CLAMAV_FAIL_CLOSED=true


# ── Destructive operations — both off unless deliberately enabled ────────────
# POST /api/demo/reset PERMANENTLY DELETES every file under the GCloud folder (no bin,
# no revisions) and empties the catalogue. Cannot be enabled in production at all; even
# enabled, it needs an authenticated administrator and a typed confirmation.
ALLOW_DESTRUCTIVE_DEMO=false
# Emptying the Drive bin reaches the WHOLE connected account, including files this
# library never touched.
ALLOW_EMPTY_DRIVE_TRASH=false
# How long one password entry covers further destructive confirmations.
STEP_UP_MAX_AGE_SEC=300

# Audit rows carry an address and a user agent — personal data. Swept nightly past this.
AUDIT_RETENTION_DAYS=400
LOG_LEVEL=info

# ── Client build ─────────────────────────────────────────────────────────────
# Only needed when the app is served from a different origin than the API.
# VITE_API_BASE=https://hub.example.com/api
